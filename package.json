{
  "name": "house-of-rivana",
  "version": "0.1.0",
  "private": true,
  "description": "House of Rivana — artificial fashion jewellery storefront and admin",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:migrate:prod": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:journey": "node scripts/journey-audit.mjs",
    "test:admin-catalog": "node scripts/e2e-admin-catalog.mjs",
    "test:admin-field-errors": "node scripts/e2e-admin-field-errors.mjs",
    "storage:check": "node scripts/check-supabase-env.mjs",
    "storage:setup": "node scripts/setup-supabase-storage.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "2.112.2",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "lenis": "1.3.26",
    "lucide-react": "^0.545.0",
    "motion": "13.0.0",
    "nanoid": "^5.1.5",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "razorpay": "2.9.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.2.1",
    "resend": "6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
