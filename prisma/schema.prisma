// House of Rivana — data model
//
// Conventions
//  * All money is stored as INTEGER PAISE (₹1 = 100). Never floats.
//  * Order and OrderItem rows snapshot names/prices so history never mutates.
//  * Stock is only ever changed through InventoryMovement so the ledger balances.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MetalType {
  YELLOW_GOLD
  ROSE_GOLD
  WHITE_GOLD
  STERLING_SILVER
  PLATINUM
  GOLD_VERMEIL
  BRASS
}

enum InventoryReason {
  ORDER
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCELLATION
  DAMAGE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_UNDER_REVIEW
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentProviderKind {
  MANUAL_UPI
  RAZORPAY
}

enum PaymentStatus {
  INITIATED
  AWAITING_CONFIRMATION
  UNDER_REVIEW
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_ORIGIN
  CANCELLED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum TimelineEntryType {
  ORDER_PLACED
  PAYMENT_INITIATED
  PAYMENT_PROOF_SUBMITTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  STATUS_CHANGED
  SHIPMENT_UPDATED
  NOTE_ADDED
  REFUND_ISSUED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity (Better Auth core tables + our additions)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  banned        Boolean   @default(false)
  marketingOptIn Boolean  @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  redemptions   CouponRedemption[]
  auditLogs     AdminAuditLog[]
  inventoryMoves InventoryMovement[] @relation("InventoryActor")
  verifiedPayments Payment[]         @relation("PaymentVerifier")
  timelineEntries  OrderTimelineEntry[] @relation("TimelineActor")

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  subtitle    String?
  description String?
  heroImage   String?
  heroBlur    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  metaTitle   String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductCollection[]

  @@index([isActive, sortOrder])
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String?
  description      String
  story            String?
  metal            MetalType     @default(YELLOW_GOLD)
  purity           String?
  gemstone         String?
  weightGrams      Float?
  dimensions       String?
  careInstructions String?
  basePricePaise   Int
  compareAtPaise   Int?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  isBestseller     Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  madeToOrderDays  Int?
  metaTitle        String?
  metaDescription  String?
  ratingAverage    Float         @default(0)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images       ProductImage[]
  variants     ProductVariant[]
  collections  ProductCollection[]
  wishlistedBy WishlistItem[]
  reviews      Review[]
  orderItems   OrderItem[]

  @@index([status, publishedAt])
  @@index([metal])
  @@index([basePricePaise])
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, sortOrder])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Public path — `/api/media/<StoredImage.id>` for uploads, or a static `/placeholders/…` URL.
  url         String
  alt         String
  width       Int?
  height      Int?
  blurDataUrl String?
  sortOrder   Int     @default(0)
  isPrimary   Boolean @default(false)
  /// Ordered frames for the drag-scrubbed 360 viewer, when supplied.
  is360Frame  Boolean @default(false)

  @@index([productId, sortOrder])
}

/// Binary image payloads (product photos, hero art, review snaps). Served at `/api/media/[id]`.
model StoredImage {
  id        String   @id @default(cuid())
  /// Logical key for auditing / cleanup, e.g. `aurora-band/1710000000.jpg`.
  path      String   @unique
  mimeType  String
  bytes     Bytes
  byteSize  Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  /// Human label shown in cart/order lines, e.g. "Gold-plated · Size 14".
  label             String
  optionSize        String?
  optionMetal       MetalType?
  optionLength      String?
  pricePaise        Int
  compareAtPaise    Int?
  weightGrams       Float?
  stockQty          Int      @default(0)
  reservedQty       Int      @default(0)
  lowStockThreshold Int      @default(2)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([productId, sortOrder])
  @@index([stockQty])
}

model InventoryMovement {
  id          String          @id @default(cuid())
  variantId   String
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta       Int
  reason      InventoryReason
  balanceAfter Int
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note        String?
  actorId     String?
  actor       User?           @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Shopping
// ---------------------------------------------------------------------------

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Opaque cookie value so guests keep a server-side cart before signing in.
  sessionToken String?    @unique
  couponCode   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  items        CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id                String       @id @default(cuid())
  productId         String
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  authorName        String
  rating            Int
  title             String?
  body              String
  imageUrls         String[]     @default([])
  status            ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean     @default(false)
  moderationNote    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([productId, status])
  @@index([status, createdAt])
}

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  description       String?
  type              CouponType
  /// PERCENT: basis of 100 (e.g. 15 = 15%). FIXED: paise. FREE_SHIPPING: ignored.
  value             Int        @default(0)
  minSubtotalPaise  Int        @default(0)
  maxDiscountPaise  Int?
  startsAt          DateTime?
  endsAt            DateTime?
  usageLimit        Int?
  usageLimitPerUser Int?
  usedCount         Int        @default(0)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountPaise Int
  createdAt     DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  phone        String
  status       OrderStatus @default(PENDING_PAYMENT)

  subtotalPaise    Int
  discountPaise    Int @default(0)
  shippingPaise    Int @default(0)
  taxPaise         Int @default(0)
  grandTotalPaise  Int
  refundedPaise    Int @default(0)
  currency         String @default("INR")

  couponId     String?
  coupon       Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode   String?

  /// Frozen copies so a later address edit never rewrites shipped history.
  shippingAddress Json
  billingAddress  Json?

  customerNote String?
  adminNote    String?
  giftWrap     Boolean @default(false)

  /// Guests open /order/<number>?t=<token>; the token is compared in constant time.
  accessToken  String  @unique

  /// Stock is held until this instant, then released by the cron sweeper.
  stockHoldExpiresAt DateTime?
  stockCommitted     Boolean  @default(false)

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       OrderItem[]
  payments    Payment[]
  shipments   Shipment[]
  timeline    OrderTimelineEntry[]
  movements   InventoryMovement[]
  redemption  CouponRedemption?
  reviews     Review[]
  notifications NotificationLog[]

  @@index([status, placedAt])
  @@index([userId, placedAt])
  @@index([email])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName   String
  productSlug   String
  variantLabel  String
  sku           String
  imageUrl      String?
  unitPricePaise Int
  quantity      Int
  lineTotalPaise Int

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id               String              @id @default(cuid())
  orderId          String
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         PaymentProviderKind
  status           PaymentStatus       @default(INITIATED)
  method           String              @default("upi")
  amountPaise      Int
  currency         String              @default("INR")

  providerOrderId   String?
  providerPaymentId String? @unique
  providerRefundId  String?

  /// Manual UPI evidence supplied by the buyer.
  upiVpa        String?
  upiUtr        String?
  payerName     String?
  proofPath     String?
  proofMimeType String?

  verifiedById   String?
  verifiedBy     User?     @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  rejectionReason String?
  failureReason  String?
  refundedPaise  Int       @default(0)

  expiresAt DateTime?
  rawPayload Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
  @@index([upiUtr])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  signatureOk Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([eventType])
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String
  awb               String?
  trackingUrl       String?
  status            ShipmentStatus @default(PENDING)
  weightGrams       Float?
  shippingCostPaise Int?
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  notes             String?
  /// Courier platform that owns this AWB — currently "SHIPROCKET" or null (manual).
  provider          String?
  /// Shiprocket order id (sr_order_id / order_id from create response).
  externalOrderId   String?
  /// Shiprocket shipment id used for AWB assign / pickup.
  externalShipmentId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  events ShipmentEvent[]

  @@index([orderId])
  @@index([awb])
  @@index([provider, externalOrderId])
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  description String
  location    String?
  occurredAt  DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

model OrderTimelineEntry {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      TimelineEntryType
  message   String
  metadata  Json?
  actorId   String?
  actor     User?             @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)
  isCustomerVisible Boolean   @default(true)
  createdAt DateTime          @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Content & operations
// ---------------------------------------------------------------------------

model SiteSetting {
  /// Single row, always id = "singleton".
  id String @id @default("singleton")

  brandName   String @default("House of Rivana")
  tagline     String @default("Fashion jewellery, made to be worn")
  supportEmail String @default("care@houseofrivana.com")
  supportPhone String @default("")
  whatsappNumber String @default("")
  instagramUrl String @default("")
  facebookUrl  String @default("")
  pinterestUrl String @default("")
  addressText  String @default("")

  announcementText    String  @default("")
  announcementEnabled Boolean @default(false)

  activePaymentProvider PaymentProviderKind @default(MANUAL_UPI)
  upiVpa       String @default("")
  upiPayeeName String @default("House of Rivana")
  upiQrImageUrl String?

  freeShippingThresholdPaise Int @default(250000)
  flatShippingRatePaise      Int @default(9900)
  /// Basis points so 3% is stored as 300 and never loses precision.
  gstBasisPoints             Int @default(300)
  gstInclusive               Boolean @default(true)
  paymentHoldMinutes         Int @default(45)
  lowStockAlertThreshold     Int @default(3)

  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  eyebrow   String?
  title     String
  subtitle  String?
  imageUrl  String
  blurDataUrl String?
  ctaLabel  String?
  ctaHref   String?
  alignment String   @default("center")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model NotificationLog {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  template   String
  recipient  String
  subject    String?
  orderId    String?
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status     NotificationStatus  @default(QUEUED)
  providerId String?
  error      String?
  attempts   Int                 @default(0)
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([orderId])
  @@index([status, createdAt])
}

model AdminAuditLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled, createdAt])
}
