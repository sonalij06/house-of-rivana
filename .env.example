# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js runtime) and .env (Prisma CLI) and fill in.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# DATABASE_URL  -> pooled connection used by the running app (Vercel serverless).
# DIRECT_URL    -> direct connection used by Prisma migrate deploy / studio.
#                  Required on Vercel so `npm run vercel-build` can apply migrations.
#
# Local docker (npm run db:up) — same value for both:
DATABASE_URL="postgresql://rivana:rivana@localhost:5433/rivana?schema=public"
DIRECT_URL="postgresql://rivana:rivana@localhost:5433/rivana?schema=public"
#
# Vercel + Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL = Transaction pooler (port 6543), append ?pgbouncer=true&sslmode=require
#     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#   DIRECT_URL   = Direct / Session mode (port 5432), append ?sslmode=require
#     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#     (or db.<ref>.supabase.co:5432 if using the direct host)
#
# Vercel + Neon:
#   DATABASE_URL = …-pooler….neon.tech/…?sslmode=require
#   DIRECT_URL   = ….neon.tech/…?sslmode=require  (non-pooler host)
#
# Tip: use a separate Preview database on Vercel so PR deploys do not migrate Production.

# App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth -----------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# Optional Google sign-in. Leave blank to hide the button.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bootstrap admin (used by `npm run db:seed`) --------------------------------
SEED_ADMIN_EMAIL="admin@houseofrivana.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Rivana Admin"

# Product photos are stored in Postgres (StoredImage) — no storage credentials needed.
#
# Optional Supabase Storage — private payment-proof screenshots only ----------
# Dashboard → Project Settings → API
#   Project URL     → NEXT_PUBLIC_SUPABASE_URL
#   anon public     → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role    → SUPABASE_SERVICE_ROLE_KEY  (never expose to the browser)
# Then: npm run storage:setup (+ supabase/storage-setup.sql for RLS).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Required for payment-proof uploads and signed URLs.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRODUCT_BUCKET="product-images"
SUPABASE_PROOF_BUCKET="payment-proofs"

# Payments -------------------------------------------------------------------
# Razorpay keys are only needed once the provider is switched on in /admin/settings.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Notifications --------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="House of Rivana <orders@houseofrivana.com>"
# WhatsApp Cloud API (Meta). Without these the admin falls back to wa.me links.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_NUMBER=""

# Cron -----------------------------------------------------------------------
# Shared secret for /api/cron/* routes (Vercel Cron sends it as a Bearer token).
CRON_SECRET="replace-me"

# Shiprocket (live ETA + AWB + tracking) ------------------------------------
# Settings → API → Create an API User (email + password / API key).
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Pickup location nickname exactly as saved in the Shiprocket panel.
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE="302001"
# Same value must be set as the webhook security token in Shiprocket
# (Settings → API → Webhooks → URL {APP_URL}/api/webhooks/fulfillment).
SHIPROCKET_WEBHOOK_TOKEN=""
